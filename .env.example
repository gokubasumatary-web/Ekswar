# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Gnani API key (from app.gnani.ai), sent as the X-API-Key-ID header
GNANI_API_KEY=

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# Gemini model name. Pick a current one from Google AI Studio; don't guess.
GEMINI_MODEL=

# Optional backup Gemini model(s), comma-separated, tried in order if the main one is
# busy/unreachable or its daily free quota is used up. e.g. gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
